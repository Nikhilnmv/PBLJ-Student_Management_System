        M["Model<br/>Student, Admin, StudentFilter"]
    end

    subgraph DB["MySQL 8 Server"]
        T1[("students")]
        T2[("admin")]
    end

    UI -- "HTTP request (GET / POST)" --> F
    F --> C
    C -- "uses" --> U
    C -- "calls" --> D
    D -- "JDBC + PreparedStatement" --> DB
    D -. "returns objects" .-> M
    C -- "forward with data" --> V
    V -- "HTML response" --> UI

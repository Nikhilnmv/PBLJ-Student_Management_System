<%--
    Admin top bar: menu button (screens narrower than 1200px), page title and the
    logged-in administrator. Uses ${pageTitle} set by the including page.
--%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<header class="topbar">
    <button class="btn btn-light-soft btn-icon d-xl-none" type="button" data-bs-toggle="offcanvas"
            data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open menu">
        <i class="bi bi-list fs-5"></i>
    </button>
    <p class="topbar-title"><c:out value="${pageTitle}"/></p>
    <div class="ms-auto d-flex align-items-center gap-2">
        <a href="${ctx}/admin/students/add" class="btn btn-sm btn-primary d-none d-md-inline-flex align-items-center">
            <i class="bi bi-plus-lg me-1"></i> Add Student
        </a>
        <span class="chip"><i class="bi bi-person-circle"></i> <c:out value="${sessionScope.loggedInAdmin.username}"/></span>
    </div>
</header>

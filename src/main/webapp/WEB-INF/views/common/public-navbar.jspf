<%--
    Top navigation bar for the public pages (home, registration, login).
    The including page may set ${activeNav} to "home", "register" or "login"
    to highlight the current link.
--%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<nav class="navbar navbar-expand-md public-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand" href="${ctx}/">
            <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="brand-text">Student Registration System<small>Online Registration Portal</small></span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"
                aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="publicNav">
            <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
                <li class="nav-item">
                    <a class="nav-link${activeNav == 'home' ? ' active' : ''}" href="${ctx}/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link${activeNav == 'register' ? ' active' : ''}" href="${ctx}/register">Register</a>
                </li>
                <li class="nav-item ms-md-2 mt-2 mt-md-0">
                    <a class="btn btn-sm btn-outline-primary px-3${activeNav == 'login' ? ' active' : ''}" href="${ctx}/login">
                        <i class="bi bi-shield-lock me-1"></i> Admin Login
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

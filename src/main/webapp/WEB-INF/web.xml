<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deployment descriptor (web.xml) for the Student Registration System.

    Servlets and filters are registered with annotations (@WebServlet,
    @WebFilter) directly in their Java classes. This file only holds
    application-wide settings: encoding, session rules, the home page
    and the friendly error pages.

    version="4.0" = Servlet 4.0, the version supported by Apache Tomcat 9.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Student Registration System</display-name>

    <!-- Read form data and write pages as UTF-8 so names like "Zoë" or "Kṛṣṇa" are stored correctly -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!-- Admin sessions -->
    <session-config>
        <!-- Log the admin out automatically after 30 minutes of inactivity -->
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- JavaScript cannot read the session cookie (helps against XSS cookie theft) -->
            <http-only>true</http-only>
        </cookie-config>
        <!-- Keep the session id in a cookie only, never in the URL -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- All JSP pages and .jspf fragments are saved as UTF-8; remove blank lines left by directives -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!--
        Tomcat's built-in security header filter. It adds headers such as
        X-Frame-Options: DENY (our pages cannot be shown inside another site's
        frame - prevents "clickjacking") and X-Content-Type-Options: nosniff.
    -->
    <filter>
        <filter-name>httpHeaderSecurity</filter-name>
        <filter-class>org.apache.catalina.filters.HttpHeaderSecurityFilter</filter-class>
        <init-param>
            <param-name>hstsEnabled</param-name>
            <param-value>false</param-value> <!-- HSTS only makes sense with HTTPS -->
        </init-param>
        <init-param>
            <param-name>antiClickJackingOption</param-name>
            <param-value>DENY</param-value>
        </init-param>
        <init-param>
            <param-name>xssProtectionEnabled</param-name>
            <param-value>false</param-value> <!-- obsolete header; escaping output is the real protection -->
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>httpHeaderSecurity</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Page shown for http://localhost:8080/student-registration/ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Friendly error pages: users never see Java stack traces -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
</web-app>
